{
  "name": "gbet-github-pages",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 5174",
    "build": "vinext build && node scripts/finalize-pages.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern out --ignore-pattern site --ignore-pattern outputs",
    "check:site": "node scripts/check-site.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:zoom": "node scripts/check-zoom.mjs",
    "precheck:zoom": "npm run prepare:media",
    "precheck:media": "npm run prepare:media",
    "prepare:media": "node scripts/prepare-media.mjs",
    "predev": "npm run prepare:media",
    "prebuild": "npm run prepare:media",
    "prelint": "npm run prepare:media",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run prepare:media",
    "precheck:site": "npm run prepare:media",
    "capture:design": "node scripts/capture-design.mjs",
    "precapture:design": "npm run prepare:media",
    "measure:lab": "node scripts/measure-lab.mjs",
    "premeasure:lab": "npm run prepare:media"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "playwright": "1.62.1",
    "prettier": "^3.9.9",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "web-vitals": "^6.2.2",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
